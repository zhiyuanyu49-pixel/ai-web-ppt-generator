# ================== 模型供应商 ==================
# 三家都是 OpenAI 兼容协议，可以同时配置，在页面下拉里随时切换。
# 只配置其中一家也能正常工作：AI_PROVIDER 指定默认使用哪家。

# 默认供应商：deepseek（默认）| zhipu | kimi
AI_PROVIDER=deepseek

# ---- DeepSeek ----
# Key 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 候选：deepseek-flash（快且便宜，推荐）| deepseek-chat | deepseek-reasoner
DEEPSEEK_MODEL=deepseek-flash

# ---- 智谱 GLM ----
# Key 申请：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=
# 国内端 open.bigmodel.cn；国际端改为 https://api.z.ai/api/paas/v4
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 候选：glm-4.7（推荐）| glm-4.6 | glm-4.5-air | glm-4-flash
ZHIPU_MODEL=glm-4.7

# ---- Kimi（Moonshot）----
# Key 申请：https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=
# 国内端 api.moonshot.cn；国际端改为 https://api.moonshot.ai/v1
KIMI_BASE_URL=https://api.moonshot.cn/v1
# 候选：kimi-k2.5（推荐）| kimi-latest | moonshot-v1-128k | moonshot-v1-32k
KIMI_MODEL=kimi-k2.5

# 服务端口 / 监听地址
# 127.0.0.1 = 仅本机可访问；0.0.0.0 = 允许局域网与内网穿透访问
PORT=8787
HOST=127.0.0.1

# 可选：本地模拟模型（1=开启，不消耗 API 额度，用于演示与自动化测试）
MOCK_AI=0
MOCK_DELAY_MS=6

# 可选：单次请求超时、最大页数、输入文案截断长度
AI_TIMEOUT_MS=300000
MAX_SLIDES=30
MAX_INPUT_CHARS=14000

# ---------------- 分享给别人用时（局域网 / 公网） ----------------
# 访问口令：留空 = 不校验（仅本机使用时）。对外分享务必设置
ACCESS_PASSWORD=
# 配额保护，避免别人刷爆你的模型额度
RATE_LIMIT_PER_DAY=15
RATE_LIMIT_PER_MINUTE=3
RATE_LIMIT_PER_DAY_GLOBAL=200
MAX_CONCURRENT=3
# 内网穿透 / 反向代理下用于获取真实客户端 IP
TRUST_PROXY=1
