# DeepSeek（OpenAI 兼容协议）配置
# 复制为 .env 后填入真实 Key
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 需求指定的模型 id；服务端会通过 /models 自动解析为真实可用 id
# 例：deepseek-V41-Flash --(规范化名称匹配)--> deepseek-flash（展示名 DeepSeek-V4.1-Flash）
DEEPSEEK_MODEL=deepseek-V41-Flash

# 服务端口 / 监听地址
# 127.0.0.1 = 仅本机可访问；0.0.0.0 = 允许局域网与内网穿透访问
PORT=8787
HOST=127.0.0.1

# 可选：本地模拟模型（1=开启，不消耗 API 额度，用于演示与自动化测试）
MOCK_AI=0
MOCK_DELAY_MS=6

# 可选：单次请求超时、最大页数、输入文案截断长度
AI_TIMEOUT_MS=300000
MAX_SLIDES=30
MAX_INPUT_CHARS=14000

# ---------------- 分享给别人用时（局域网 / 公网） ----------------
# 访问口令：留空 = 不校验（仅本机使用时）。对外分享务必设置
ACCESS_PASSWORD=
# 配额保护，避免别人刷爆你的模型额度
RATE_LIMIT_PER_DAY=15
RATE_LIMIT_PER_MINUTE=3
RATE_LIMIT_PER_DAY_GLOBAL=200
MAX_CONCURRENT=3
# 内网穿透 / 反向代理下用于获取真实客户端 IP
TRUST_PROXY=1
